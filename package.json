{
  "name": "teml",
  "version": "0.3.0",
  "description": "Terminal Markup Language — semantic documents for terminals",
  "keywords": [
    "terminal",
    "cli",
    "markdown",
    "markup",
    "tui",
    "ansi",
    "terminal-ui",
    "pager",
    "accessibility"
  ],
  "author": "Fogha <collinslord50@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fogha/teML.git"
  },
  "homepage": "https://github.com/fogha/teML#readme",
  "bugs": {
    "url": "https://github.com/fogha/teML/issues"
  },
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "teml": "dist/cli/main.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interactive": {
      "types": "./dist/interactive/host.d.ts",
      "import": "./dist/interactive/host.js"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc && node scripts/copy-assets.mjs",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm run pack:verify",
    "test": "pnpm run test:invariants && pnpm run test:system",
    "test:check-build": "node scripts/assert-built.mjs",
    "pretest:invariants": "pnpm run test:check-build",
    "test:invariants": "vitest run --config vitest.invariants.config.ts",
    "pretest:system": "pnpm run test:check-build",
    "test:system": "vitest run --config vitest.system.config.ts",
    "test:all": "pnpm test && pnpm run test:perf",
    "test:watch": "vitest --config vitest.invariants.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:rust-host": "cargo test --locked --all-features --manifest-path crates/teml-host/Cargo.toml && cargo test --locked --manifest-path examples/rust-host/Cargo.toml",
    "test:go-host": "cd hosts/go && go test ./... -count=1",
    "test:python-host": "cd hosts/python && python3 -m pytest -q",
    "test:hosts": "pnpm run test:rust-host && pnpm run test:go-host && pnpm run test:python-host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:verify": "node scripts/pack-verify.mjs",
    "release:pack": "pnpm run build && node scripts/release-pack.mjs",
    "host:engine:prepare": "node scripts/prepare-host-engine.mjs",
    "sea:bundle": "node scripts/sea/bundle.mjs",
    "sea:build": "node scripts/sea/build.mjs",
    "sea:verify": "node scripts/sea/verify.mjs",
    "sea:bench": "node scripts/sea/bench.mjs",
    "presea:bundle": "pnpm run build",
    "presea:build": "pnpm run sea:bundle",
    "dev": "tsx src/cli/main.ts",
    "demo": "node dist/cli/main.js examples/markup/demo.teml",
    "demo:command-center": "node dist/cli/main.js view examples/markup/service-command-center.teml --theme dark --width 100",
    "demo:interactive": "node examples/interactive/interactive-host.mjs examples/interactive/interactive-form.teml",
    "demo:log-viewer": "node examples/interactive/interactive-host.mjs examples/interactive/log-viewer.teml",
    "demo:live-progress": "node examples/interactive/live-progress.mjs",
    "demo:rust-host": "cargo run --manifest-path examples/rust-host/Cargo.toml",
    "demo:go-host": "cd hosts/go && go run ./examples/incident-handoff",
    "demo:python-host": "cd hosts/python && PYTHONPATH=src python3 examples/incident_handoff/main.py",
    "demo:chat": "node examples/apps/chat/deepseek-chat.mjs",
    "demo:settings": "node examples/apps/settings-app.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "commander": "^14.0.0",
    "linkedom": "^0.18.12",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^8.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "string-width": "^7.2.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  }
}
